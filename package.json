{
  "name": "polygnome",
  "version": "0.10.5",
  "dataMinApp": "0.5.0",
  "description": "Polygnome: local, unlimited SimulationCraft gear optimizer (Top Gear, Droptimizer, Best in Slot)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "author": "Polygnome",
  "build": {
    "appId": "com.localbots.app",
    "generateUpdatesFilesForAllChannels": true,
    "productName": "Polygnome",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "data/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danetch",
        "repo": "localbots",
        "releaseType": "release"
      }
    ]
  }
}
